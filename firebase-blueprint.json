{
  "collections": [
    {
      "name": "students",
      "description": "Store student details, grades, and information",
      "fields": [
        { "name": "fullName", "type": "string" },
        { "name": "gender", "type": "string" },
        { "name": "ethnicity", "type": "string" },
        { "name": "status", "type": "string" },
        { "name": "academicPerformance", "type": "string" },
        { "name": "conduct", "type": "string" },
        { "name": "cp", "type": "number" },
        { "name": "kp", "type": "number" },
        { "name": "award", "type": "string" },
        { "name": "grades", "type": "map" },
        { "name": "comments", "type": "array" },
        { "name": "notifications", "type": "array" },
        { "name": "stt", "type": "number" }
      ],
      "access": {
        "read": "Anyone",
        "create": "Anyone",
        "update": "Anyone",
        "delete": "Anyone"
      }
    },
    {
      "name": "settings",
      "description": "Store system application settings, branding, logos, and UI appearance",
      "fields": [
        { "name": "pageTitle", "type": "string" },
        { "name": "pageIcon", "type": "string" },
        { "name": "portalBackground", "type": "string" },
        { "name": "portalLogo", "type": "string" },
        { "name": "loginLogo", "type": "string" },
        { "name": "loginBackground", "type": "string" },
        { "name": "appName", "type": "string" },
        { "name": "disablePortal", "type": "boolean" },
        { "name": "updatedAt", "type": "string" }
      ],
      "access": {
        "read": "Anyone",
        "create": "Anyone",
        "update": "Anyone",
        "delete": "Anyone"
      }
    },
    {
      "name": "users",
      "description": "Store user accounts, roles, teacher sub-roles (GVCN / GVBM), and module permissions",
      "fields": [
        { "name": "username", "type": "string" },
        { "name": "fullName", "type": "string" },
        { "name": "role", "type": "string" },
        { "name": "teacherType", "type": "string" },
        { "name": "homeroomClasses", "type": "array" },
        { "name": "subjectClasses", "type": "array" },
        { "name": "subjects", "type": "array" },
        { "name": "permissions", "type": "map" }
      ],
      "access": {
        "read": "Anyone",
        "create": "Anyone",
        "update": "Anyone",
        "delete": "Anyone"
      }
    }
  ]
}
